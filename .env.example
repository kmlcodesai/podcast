# API Keys for enhanced scraping (optional)
# Without these, scrapers will fall back to web scraping which is slower

# YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Listen Notes API key
# Get one at: https://www.listennotes.com/api/
LISTEN_NOTES_API_KEY=your_listen_notes_api_key_here
